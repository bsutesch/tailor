{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/market",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=21600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/rarity",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=21600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
